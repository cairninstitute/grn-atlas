[
  {
    "skill": "grn-celltype-regulon",
    "label": "celltype regulon: imported TP53 treated cluster",
    "question": "Using imported dataset {dataset_id}, show the TP53 regulon active in the treated cluster in human.",
    "expected_tools": ["grn_celltype_regulon"],
    "requires_http": true,
    "setup_http_posts": [
      {
        "path": "/api/v1/import/omics",
        "json": {
          "name": "llm fixture celltype regulon",
          "species": "human",
          "data_type": "pseudobulk",
          "gene_values": {
            "TP53": [5.0, 1.0],
            "MDM2": [1.0, 5.0],
            "CDKN1A": [4.0, 1.0],
            "BAX": [3.0, 1.0],
            "BCL2": [1.0, 4.0]
          },
          "sample_names": ["A", "B"],
          "contrasts": [
            {
              "group_a": "treated",
              "group_b": "control",
              "deg": {
                "TP53": 2.5,
                "MDM2": -1.8,
                "CDKN1A": 3.1,
                "BAX": 1.2,
                "BCL2": -1.7
              }
            }
          ]
        },
        "capture": {
          "dataset_id": "dataset_id"
        }
      }
    ],
    "checks": [
      {
        "type": "tool_in",
        "tools": ["grn_celltype_regulon"]
      },
      {
        "type": "arg_equals",
        "arg": "dataset_id",
        "value": "{dataset_id}"
      },
      {
        "type": "arg_equals",
        "arg": "cluster_id",
        "value": "treated"
      },
      {
        "type": "arg_contains",
        "arg": "gene_id",
        "value": "TP53"
      }
    ]
  },
