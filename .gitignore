# Python
__pycache__/
*.py[cod]
*.bak
*.bak[0-9]
venv/
.venv/
backend/venv
*.egg-info/

# Node
node_modules/
npm-debug.log*

# Env
.env
.env.local
.env.*.local

# Build output
build/
dist/

# Generated data (rebuilt from backend/data/*.tsv,*.json at startup)
backend/data/*.sqlite3

# Resumable fetch checkpoint (internal to fetch_genome_data.py)
backend/data/.oma_cache.json

# Skill test artifacts (regenerated by _test_all_skills.py)
.agents/skills/_test_results*.json
.agents/skills/_test_qa_pairs.json

# OS
.DS_Store

# Expression pipeline working files (keep only the final matrix artifact)
tools/
backend/data/expr/
paseo.json

# Third-party source data + derived caches — not redistributed; regenerate with
# backend/scripts/fetch_sources.py (see LICENSE + docs/DEVELOPMENT.md).
backend/data/*.json
backend/data/*.json.gz
backend/data/*.tsv
backend/data/*.fasta.gz
backend/data/*.assembly.gz

# Exception: hand-curated files that cannot be regenerated from upstream sources.
# These MUST be tracked — they contain literature-sourced edges and gold standards.
!backend/data/gold_standard_*.tsv
!backend/data/regulation_petunia.tsv
!backend/data/regulation_tomato.tsv
!backend/data/curated_symbols_tomato.json
!backend/data/curated_symbols_petunia.json

# Exception: validation and benchmark reports — tracked for reproducibility.
!backend/data/network_validation_report.md
!backend/data/network_stats_*.json
!backend/data/quality_report_*.json
!backend/data/beeline_benchmark_report.json

test-results/
